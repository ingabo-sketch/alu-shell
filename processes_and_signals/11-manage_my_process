#!/usr/bin/env bash
# Starts, stops, and restarts manage_my_process
pidfile="/var/run/my_process.pid"
script="$(dirname "$0")/manage_my_process"

if [ "$1" = "start" ]
then
    "$script" &
    echo "$!" > "$pidfile"
    echo "manage_my_process started"
elif [ "$1" = "stop" ]
then
    kill "$(cat "$pidfile")"
    rm -f "$pidfile"
    echo "manage_my_process stopped"
elif [ "$1" = "restart" ]
then
    kill "$(cat "$pidfile")"
    rm -f "$pidfile"
    "$script" &
    echo "$!" > "$pidfile"
    echo "manage_my_process restarted"
else
    echo "Usage: manage_my_process {start|stop|restart}"
fi
